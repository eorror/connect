<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>Connect</string>
    <key>CFBundleDisplayName</key><string>Connect</string>
    <key>CFBundleIdentifier</key><string>com.stevenros.connect</string>
    <key>CFBundleExecutable</key><string>Connect</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>__VERSION__</string>
    <key>CFBundleVersion</key><string>__BUILD__</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>LSMinimumSystemVersion</key><string>14.0</string>
    <key>LSUIElement</key><true/>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSHumanReadableCopyright</key><string>Made with love</string>

    <!-- Notes server (Supabase). Filled from version.env; empty means "ask in setup". -->
    <key>ConnectSupabaseURL</key><string>__SUPABASE_URL__</string>
    <key>ConnectSupabaseKey</key><string>__SUPABASE_KEY__</string>

    <!-- Sparkle over-the-air updates -->
    <key>SUFeedURL</key><string>__FEED_URL__</string>
    <key>SUPublicEDKey</key><string>7iUtl971nX6itIe6a33WhNKCAFkeqaCnVM2yL8p+4Dg=</string>
    <key>SUEnableAutomaticChecks</key><true/>
    <key>SUAutomaticallyUpdate</key><true/>
    <key>SUScheduledCheckInterval</key><integer>3600</integer>
</dict>
</plist>
